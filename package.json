{
  "name": "mxraven-js-plugins",
  "private": true,
  "description": "Official plugins for the mxRaven TypeScript SDK: template renderers for React, Vue, Pug, and more.",
  "license": "Apache-2.0",
  "author": "SynqronLabs Private Limited",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.5.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "~0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.26.0"
}
