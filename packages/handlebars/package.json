{
  "name": "@mxraven/handlebars",
  "version": "0.0.0",
  "description": "Handlebars template renderer plugin for @mxraven/mail.",
  "keywords": [
    "email",
    "handlebars",
    "mxraven",
    "template"
  ],
  "homepage": "https://github.com/synqronlabs/mxraven-js-plugins",
  "bugs": {
    "url": "https://github.com/synqronlabs/mxraven-js-plugins/issues"
  },
  "license": "Apache-2.0",
  "author": "SynqronLabs Private Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synqronlabs/mxraven-js-plugins.git",
    "directory": "packages/handlebars"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "handlebars": "^4.7.10",
    "html-to-text": "^9.0.5"
  },
  "devDependencies": {
    "@mxraven/mail": "^0.2.2",
    "@types/html-to-text": "^9.0.4"
  },
  "peerDependencies": {
    "@mxraven/mail": ">=0.2.2 <1"
  }
}
