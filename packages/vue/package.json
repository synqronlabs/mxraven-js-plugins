{
  "name": "@mxraven/vue",
  "version": "0.0.1",
  "description": "Vue template renderer plugin for @mxraven/mail.",
  "keywords": [
    "email",
    "mxraven",
    "template",
    "vue"
  ],
  "homepage": "https://github.com/synqronlabs/mxraven-js-plugins",
  "bugs": {
    "url": "https://github.com/synqronlabs/mxraven-js-plugins/issues"
  },
  "license": "Apache-2.0",
  "author": "SynqronLabs Private Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synqronlabs/mxraven-js-plugins.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vue-email/render": "^0.0.9",
    "html-to-text": "^9.0.5"
  },
  "devDependencies": {
    "@mxraven/mail": "^0.2.2",
    "@types/html-to-text": "^9.0.4",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "@mxraven/mail": ">=0.2.2 <1",
    "vue": "^3.5.0"
  }
}
