{
  "name": "@mxraven/react",
  "version": "0.0.1",
  "description": "React template renderer plugin for @mxraven/mail.",
  "keywords": [
    "email",
    "mxraven",
    "react",
    "template"
  ],
  "homepage": "https://github.com/synqronlabs/mxraven-js-plugins",
  "bugs": {
    "url": "https://github.com/synqronlabs/mxraven-js-plugins/issues"
  },
  "license": "Apache-2.0",
  "author": "SynqronLabs Private Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synqronlabs/mxraven-js-plugins.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0"
  },
  "devDependencies": {
    "@mxraven/mail": "^0.2.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "@mxraven/mail": ">=0.2.1",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
